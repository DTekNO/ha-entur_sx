{%- if disruptions and disruptions | length > 0 -%}
{#- Group disruptions by line and display with badge shown once per line -#}
{%- for group in disruptions | groupby('line_name') %}
{%- set line_name = group.grouper -%}
{%- set line_disruptions = group.list -%}
{%- set first_disruption = line_disruptions[0] -%}
{%- set transport_mode = first_disruption.get('transport_mode', 'bus') -%}
{%- set badge_svg = first_disruption.get('badge_svg', '') -%}

{#- Show separator before each entry except the first -#}
{%- if not loop.first %}

---

{%- endif %}

{#- Show badge once for this line -#}
{%- if badge_svg %}
<img src="{{ badge_svg }}" alt="{{ transport_mode }} {{ line_name }}" height="32">
{%- endif %}

{#- Show each disruption for this line -#}
{%- for disruption in line_disruptions %}
{%- set summary = disruption.get('summary', 'Disruption') -%}
{%- set description = disruption.get('description', '') -%}
{%- set valid_from = disruption.get('valid_from_formatted', disruption.get('valid_from', '')) -%}
{%- set valid_to = disruption.get('valid_to_formatted', disruption.get('valid_to', '')) -%}

<table role="presentation">
<tr>
<td>
📅 <i>{% if valid_from %}From: {{ valid_from }}{% endif %}</i>
</td>
</tr>
<tr>
<td>
📅 <i>{% if valid_to %}To: {{ valid_to }}{% else %}{% if valid_from %}Until further notice{% endif %}{% endif %}</i>
</td>
</tr>
</table>

{%- if description %}
<ha-alert alert-type="info" title="{{ summary }}">

{{ description }}

</ha-alert>

{% else %}
**{{ summary }}**

{% endif %}

{%- endfor %}

{%- endfor -%}
{%- else -%}
✓ **No active disruptions**
{%- endif -%}
